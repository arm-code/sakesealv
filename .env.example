# --- Base de datos (libSQL / Turso) ---
# Archivo local: file:./.data/dev.db   |   Turso: libsql://<db>.turso.io (+ token)
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# --- Almacenamiento S3-compatible ---
# R2: https://<account-id>.r2.cloudflarestorage.com | SeaweedFS local: http://localhost:8333
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para SeaweedFS/MinIO, false para R2/S3
S3_FORCE_PATH_STYLE=

# --- Búsqueda de libros ---
# Lista separada por comas: anna, openlib (openlibrary), gutenberg, zlib (zlibrary).
# Vacío = la búsqueda queda deshabilitada y "Search" se oculta del menú.
ACTIVATED_PROVIDERS=
# Mirror(s) de Z-Library (HTTPS, separados por comas). Settings → Integrations lo sobreescribe al guardar.
ZLIBRARY_BASE_URL=

# --- Metadata ---
# googlebooks, openlibrary, hardcover, isbndb. Vacío = lookup deshabilitado.
ACTIVATED_METADATA_PROVIDERS=
GOOGLE_BOOKS_API_KEY=
ISBNDB_API_KEY=
HARDCOVER_API_TOKEN=
METADATA_PROVIDER_TIMEOUT_MS=

# --- Opcionales ---
# Nivel de log de pino (fatal|error|warn|info|debug|trace). Por defecto info.
LOG_LEVEL=
# true = modo demo (bloquea el sync real con Hardcover).
SAKE_DEMO_MODE=
